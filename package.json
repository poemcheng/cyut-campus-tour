    "build:pages": "npm run build && node scripts/prepare-pages.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.158.0",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.158.3",
    "typescript": "5.7.3",
    "vite": "6.1.0"
  }
}
